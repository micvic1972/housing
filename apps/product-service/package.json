{
  "name": "product-service",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/index.ts",
    "predev": "pnpm --filter @repo/product-db run build",
    "build": "pnpm --filter @repo/product-db run build && tsc",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "check-types": "tsc --noEmit",
    "test": "node --import tsx --test src/lib/*.test.ts src/middleware/*.test.ts src/controller/listing/*.test.ts"
  },
  "dependencies": {
    "@clerk/backend": "^3.25.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.4",
    "@repo/product-db": "workspace:*",
    "fastify": "^5.12.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.2"
  }
}
