// ============================================================================
// product-db: the database schema for UniNest.
// One file, one place that describes what a "listing" is.
// If a new fact about a listing is added in the client's types.ts,
// it gets added here too, then a migration is run.
// ============================================================================

generator client {
  // Prisma 7 style: the generated client lives in the repo, not in node_modules.
  // product-service imports it from this path.
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Connection URLs are supplied by prisma7.config.ts from the product-db
  // package environment or the process environment.
}

// A listing: one place a student could rent.
// The nested objects from the client's types.ts (location, pricing, contact,
// paymentOptions, safety) are flattened into columns here on purpose:
// simpler queries, fewer joins, and only one university to worry about for now.
model Listing {
  id       String @id @default(cuid())
  name     String
  kind     String
  status   String
  roomType String

  area       String
  // Which UNIDEL campus this place is near: "alihame" | "owa-oyibu" | "owa-alero".
  // null = not reported yet (honest-gap rule), so old listings stay valid.
  campus     String?
  landmark   String?
  distanceKm Float?
  latitude   Float?
  longitude  Float?
  locationVerified   Boolean   @default(false)
  locationVerifiedBy String?
  locationVerifiedAt DateTime?

  priceAmount   Int
  priceCurrency String @default("NGN")
  pricePeriod   String

  amenities String[]

  verified       Boolean  @default(false)
  verifiedChecks String[]

  rating      Float?
  reviewCount Int?

  // "owner" | "agent" | "university-partner"; null = not reported yet.
  contactType         String?
  // "unknown" | "none" | "confirmed"; the honest-gap rule in one column.
  inspectionFeeStatus String  @default("unknown")
  inspectionFeeAmount Int?

  acceptedPeriods      String[]
  requiresUpfrontYears Int?

  hasSecurityPost Boolean?
  isGatedCompound Boolean?

  popularityScore      Int?
  constructionProgress Int?
  expiresAt            DateTime?
  insight              String?

  images             ListingImage[]
  savedBy            SavedListing[]
  inspectionRequests InspectionRequest[]
  conversations      Conversation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind])
  @@index([area])
  @@index([priceAmount])
}

// Images for a listing, ordered by position (0, 1, 2...).
model ListingImage {
  id        String  @id @default(cuid())
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url       String
  alt       String
  position  Int

  @@index([listingId])
}

model SavedListing {
  id        String   @id @default(cuid())
  studentId String
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([studentId, listingId])
  @@index([studentId])
}

model InspectionRequest {
  id                    String    @id @default(cuid())
  listingId             String
  listing               Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  studentId             String
  clientRequestId       String
  scheduledFor          DateTime
  rescheduleProposedFor DateTime?
  status                String    @default("requested")
  notes                 String?
  adminResponse         String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([studentId, clientRequestId])
  @@index([studentId, status, scheduledFor])
  @@index([listingId, status, scheduledFor])
}

model Conversation {
  id              String    @id @default(cuid())
  listingId       String
  listing         Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  studentId       String
  assignedAdminId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  messages        Message[]

  @@unique([studentId, listingId])
  @@index([studentId, updatedAt])
  @@index([assignedAdminId, updatedAt])
}

model Message {
  id              String       @id @default(cuid())
  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId        String
  senderRole      String
  clientMessageId String
  body            String
  readAt          DateTime?
  createdAt       DateTime     @default(now())

  @@unique([conversationId, clientMessageId])
  @@index([conversationId, createdAt])
  @@index([conversationId, senderRole, readAt])
}
